{
  "name": "agrovision-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev --port ${PORT:-3000} --hostname 0.0.0.0",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "format": "oxfmt",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.25",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
